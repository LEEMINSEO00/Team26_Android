<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="imageUrl"
            type="String" />
    </data>

    <ImageView
        android:id="@+id/imageView_ad"
        android:layout_width="300dp"
        android:layout_height="460dp"
        android:scaleType="fitXY"
        android:layout_marginEnd="20dp"
        imageUrl="@{imageUrl}"/>

</layout>